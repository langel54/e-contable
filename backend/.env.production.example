# Copiar a .env.production (gitignored). Usado con: make prod / compose.prod.yaml
# En contenedores, compose suele sobrescribir DATABASE_URL a host.docker.internal:3307.
# SCRAPER_WORKER_URL: en Docker suele ser http://backend-worker:3101

SCRAPER_WORKER_URL="http://backend-worker:3101"
SCRAPER_WORKER_PORT=3101

DATABASE_URL="mysql://usuario:clave@localhost:3307/db_cont"
PORT=3001
NODE_ENV=production

JWT_SECRET="definir-secreto-seguro"

SUNAT_TRAMITES_CONSULTAS_URL=""
SUNAT_DECLARACIONES_PAGOS=""
SUNAT_RENTA_ANUAL=""
SUNAFIL_LOGIN_URL=""
SUNAT_ACCESS_MODE=plugin
SUNAFIL_ACCESS_MODE=plugin
