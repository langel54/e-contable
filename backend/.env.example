# Plantilla genérica. Para Docker usa archivos dedicados:
#   .env.development  → make dev   (ver .env.development.example)
#   .env.production    → make prod  (ver .env.production.example)

# MySQL (local sin Docker). En contenedores compose usa host.docker.internal:3307 salvo override.
DATABASE_URL="mysql://usuario:clave@localhost:3307/db_cont"

PORT=3001
NODE_ENV=development

# Worker de scraping (proceso aparte). API llama por HTTP a este host.
# SCRAPER_WORKER_URL=http://127.0.0.1:3101
# SCRAPER_WORKER_PORT=3101
# SCRAPER_WORKER_SECRET=  # opcional; misma clave en API y worker

# Secreto para firmar JWT (usar valor largo y aleatorio en producción)
JWT_SECRET="definir-secreto-seguro"

# CORS: orígenes permitidos separados por coma
# ALLOWED_ORIGINS=http://localhost,http://127.0.0.1,http://localhost:80,http://127.0.0.1:80,http://localhost:3000,http://127.0.0.1:3000

# --- SUNAT (URLs de login OAuth2 del menú SOL; valores según documentación / entorno SUNAT) ---
SUNAT_TRAMITES_CONSULTAS_URL=""
SUNAT_DECLARACIONES_PAGOS=""
SUNAT_RENTA_ANUAL=""

# --- SUNAFIL ---
SUNAFIL_LOGIN_URL=""

# Modo: plugin (URL con #autologin para extensión) | curl (login en servidor)
SUNAT_ACCESS_MODE=plugin
SUNAFIL_ACCESS_MODE=plugin
