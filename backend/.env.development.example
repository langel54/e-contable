# Copiar a .env.development (gitignored). Usado con: make dev / compose.dev.yaml
#
# Worker Playwright (sin Redis): `npm run worker` en otra terminal o contenedor backend-worker.
# En Docker, compose suele fijar SCRAPER_WORKER_URL=http://backend-worker:3101

SCRAPER_WORKER_URL="http://127.0.0.1:3101"
SCRAPER_WORKER_PORT=3101

DATABASE_URL="mysql://usuario:clave@localhost:3307/db_cont"
PORT=3001
NODE_ENV=development

JWT_SECRET="definir-secreto-seguro"

# SUNAT / SUNAFIL (mismas claves que .env.production.example)
SUNAT_TRAMITES_CONSULTAS_URL=""
SUNAT_DECLARACIONES_PAGOS=""
SUNAT_RENTA_ANUAL=""
SUNAFIL_LOGIN_URL=""
SUNAT_ACCESS_MODE=plugin
SUNAFIL_ACCESS_MODE=plugin
