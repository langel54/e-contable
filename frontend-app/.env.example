# Copiar a .env solo si necesitas valores locales; preferir .env.development / .env.production.
# El cliente usa NEXT_PUBLIC_API_URL=/api y Next reenvía al backend (BACKEND_URL en servidor).

# next dev local (ver también .env.development)
BACKEND_URL=http://127.0.0.1:3001
NEXT_PUBLIC_API_URL=/api

# --- Tema MUI (opcional; valores por defecto = tema moderno indigo/slate) ---
# NEXT_PUBLIC_THEME_PRIMARY_MAIN="#7c3aed"
# NEXT_PUBLIC_THEME_BG_DEFAULT="#f4f4f5"
# NEXT_PUBLIC_THEME_BG_PAPER="#ffffff"
# NEXT_PUBLIC_THEME_DARK_BG="#09090b"
# NEXT_PUBLIC_THEME_DARK_PAPER="#18181b"
