# Copiar a .env en la raíz del repositorio (opcional).
# Docker Compose sustituye ${HTTP_PORT} y similares desde este archivo.

# Puerto publicado por nginx (compose.yaml)
HTTP_PORT=80

# Opcional: URL de MySQL vista desde los contenedores (si no usas el default del compose)
# DATABASE_URL=mysql://usuario:clave@host.docker.internal:3307/db_cont

# Opcional: orígenes CORS del backend (lista separada por comas)
# ALLOWED_ORIGINS=http://localhost,http://127.0.0.1,http://localhost:80,http://127.0.0.1:80

# Opcional: mismo valor en backend y backend-worker para proteger el HTTP interno del worker
# SCRAPER_WORKER_SECRET=
